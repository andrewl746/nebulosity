# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI tool config files
AGENTS.md
CLAUDE.md
.claude/

# nebulosity generated data (derived, always rebuildable)
.nebulosity/

# Gradle's own output when the Java test fixture gets built (by hand or by an editor's Java tooling). The fixture's
# tracked .gradle/8.10 is part of the test and stays.
/test/fixtures/java-repo/tools/.gradle/*
!/test/fixtures/java-repo/tools/.gradle/8.10/
/test/fixtures/java-repo/tools/build/

# the eval runner's half-written transcripts (a .gz is written as .tmp and renamed once its index line is in)
eval/runs/*.tmp
eval2/runs/*.tmp
eval2/dev/runs/*.tmp
eval3/runs/*.tmp
eval3/dev/runs/*.tmp

# working notes, design records and plans: kept locally, not published
/docs/*.md
!/docs/GUIDE.md
!/docs/BENCHMARKS.md
!/docs/EVALUATION.md
/docs/plans/
/docs/screenshots/v1-3-1/
