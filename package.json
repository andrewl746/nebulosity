{
  "name": "nebulosity",
  "version": "1.0.1",
  "description": "A live map of how a big codebase fits together, for Claude Code and for you, with a local import index, an MCP server and the Map.",
  "keywords": [
    "claude-code",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "codebase",
    "code-map",
    "import-graph",
    "dependency-graph",
    "code-search",
    "monorepo",
    "typescript",
    "javascript",
    "python",
    "go",
    "java",
    "csharp",
    "rust"
  ],
  "homepage": "https://nebulosity.ca",
  "bugs": {
    "url": "https://github.com/andrewl746/nebulosity/issues"
  },
  "license": "MIT",
  "author": "Andrew Li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewl746/nebulosity.git"
  },
  "bin": {
    "nebulosity": "bin/nebulosity.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/",
    "lib/",
    "mcp/",
    "scripts/cli.ts",
    "scripts/commands/",
    "scripts/index.ts",
    "scripts/summarize.ts",
    "scripts/background.ts",
    "scripts/env.ts",
    "scripts/mcp-smoke.mjs",
    "app/",
    "public/",
    "next.config.ts",
    "proxy.ts",
    "instrumentation.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    ".next/",
    "!.next/cache/",
    "!.next/dev/",
    "!.next/**/*.map",
    "!.next/**/*.nft.json",
    "!**/*.test.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "build:package": "next build && node scripts/prepare-package.mjs",
    "prepack": "node scripts/prepare-package.mjs --check",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "index": "tsx scripts/index.ts",
    "summarize": "tsx scripts/summarize.ts",
    "search": "tsx scripts/search.ts",
    "live": "tsx scripts/live.ts",
    "mcp": "node mcp/launch.mjs",
    "bench-mcp": "tsx scripts/bench-mcp.ts",
    "bench-map": "tsx scripts/bench-map.ts",
    "bench-update": "tsx scripts/bench-update.ts",
    "bench-search": "tsx scripts/bench-search.ts",
    "bench-calls": "tsx scripts/bench-calls.ts",
    "bench-languages": "tsx scripts/bench-languages.ts",
    "check-layout": "node scripts/check-layout.mjs",
    "check-routes": "tsx scripts/check-routes.ts",
    "compare-summaries": "tsx scripts/compare-summaries.ts",
    "eval:run": "tsx scripts/eval/run.ts",
    "eval:probe": "tsx scripts/eval/probe.ts",
    "eval:truth": "tsx scripts/eval/build-truth.ts",
    "eval:score": "tsx scripts/eval/score.ts",
    "eval:grading": "tsx scripts/eval/grading.ts",
    "eval:overlap": "tsx scripts/eval/overlap.ts",
    "eval:needed": "tsx scripts/eval/needed.ts",
    "eval:draw": "tsx scripts/eval/draw.ts",
    "eval:context": "tsx scripts/eval/context-report.ts",
    "export-demo": "tsx scripts/export-demo.ts",
    "build-demo": "tsx scripts/build-demo.ts",
    "serve-demo": "tsx scripts/serve-demo.ts",
    "preview-folders": "tsx scripts/preview-folders.ts",
    "report-resolution": "tsx scripts/report-resolution.ts",
    "dump-index": "tsx scripts/dump-index.ts",
    "grammars": "node scripts/copy-grammars.mjs",
    "sample-edges": "tsx scripts/sample-edges.ts",
    "measure-typecheck": "node --max-old-space-size=16384 --import tsx scripts/measure-typecheck.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dagrejs/dagre": "^3.1.1",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tabler/icons-react": "3.47.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.2",
    "highlight.js": "11.11.1",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "smol-toml": "1.9.1",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-rust": "0.24.0",
    "vitest": "^4.1.10"
  }
}
