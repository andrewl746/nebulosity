# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI tool config files
AGENTS.md
CLAUDE.md
.claude/

# nebulosity generated data (derived, always rebuildable)
.nebulosity/

# the eval runner's half-written transcripts (a .gz is written as .tmp and renamed once its index line is in)
eval/runs/*.tmp
eval2/runs/*.tmp
eval2/dev/runs/*.tmp
eval3/runs/*.tmp
eval3/dev/runs/*.tmp
